<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.QuizTakeController" style="-fx-background-color: #f7f7fb;">
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox alignment="TOP_CENTER" spacing="18">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <VBox styleClass="app-topic-card" spacing="14" maxWidth="720">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <VBox HBox.hgrow="ALWAYS">
                        <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" wrapText="true"/>
                        <Label fx:id="subtitleLabel" style="-fx-text-fill: #71717a;"/>
                    </VBox>
                    <Label fx:id="countdownLabel" styleClass="app-tag, app-tag-purple" style="-fx-font-size: 13px;"/>
                </HBox>

                <Label fx:id="errorLabel" style="-fx-text-fill: #b91c1c; -fx-font-weight: bold;" wrapText="true"/>
                <Button fx:id="backToDashboardButton" text="Back to Dashboard" styleClass="app-btn-light" onAction="#handleBackToDashboard" visible="false" managed="false"/>
                <Label fx:id="warningLabel" style="-fx-text-fill: #c46d00; -fx-font-weight: bold;" wrapText="true" visible="false" managed="false"/>

                <VBox fx:id="proctorGate" spacing="12" visible="false" managed="false">
                    <Label text="🛡 This is a proctored quiz." style="-fx-font-weight: bold;"/>
                    <Label text="Switching away from this window or leaving fullscreen will be recorded as a warning. After 3 warnings your quiz will be auto-submitted as-is." wrapText="true"/>
                    <Button text="Enter fullscreen &amp; begin" styleClass="app-btn-primary" onAction="#handleBeginProctored"/>
                </VBox>

                <VBox fx:id="questionsBox" spacing="18"/>

                <Button fx:id="submitButton" text="Submit quiz" styleClass="app-btn-primary" onAction="#handleSubmit"/>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
