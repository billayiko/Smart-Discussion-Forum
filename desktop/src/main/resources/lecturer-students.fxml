<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.LecturerStudentsController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <VBox>
                <Label text="Students" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="See who is currently online and who is subscribed to your topics." style="-fx-text-fill: #71717a;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </padding>

            <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

            <FlowPane fx:id="statsBox" hgap="12" vgap="12"/>

            <TableView fx:id="studentsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Student" prefWidth="200"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="110"/>
                    <TableColumn fx:id="topicsColumn" text="Subscribed to your topics" prefWidth="320"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
