<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.TopicThreadsController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <Button text="&#8592; Back" styleClass="app-btn-light" onAction="#handleBack"/>
            <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Export PDF" styleClass="app-btn-light" onAction="#handleExportPdf"/>
            <Button fx:id="exportCsvButton" text="Export Participation CSV" styleClass="app-btn-light" onAction="#handleExportCsv" visible="false" managed="false"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="14">
                <padding>
                    <Insets top="8" right="16" bottom="16" left="16"/>
                </padding>
                <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

                <VBox fx:id="threadsBox" spacing="12"/>

                <VBox styleClass="app-composer" spacing="8">
                    <Label text="Ask a question" style="-fx-font-weight: bold;"/>
                    <TextField fx:id="questionTitleField" promptText="Question title" styleClass="app-composer-input"/>
                    <HBox spacing="10">
                        <TextArea fx:id="questionBodyField" promptText="Describe your question..." prefRowCount="2" wrapText="true" styleClass="app-composer-input" HBox.hgrow="ALWAYS"/>
                        <Button text="Ask" styleClass="app-btn-primary" onAction="#handleAsk"/>
                    </HBox>
                </VBox>

                <VBox styleClass="app-stat-card" spacing="8">
                    <Label text="Student Participation" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <VBox fx:id="leaderboardBox" spacing="6"/>
                </VBox>

                <VBox styleClass="app-stat-card" spacing="8">
                    <Label text="Recent Activity" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <VBox fx:id="activityBox" spacing="6"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
