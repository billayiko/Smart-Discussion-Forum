<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.SidebarController"
      styleClass="app-sidebar" spacing="6">
    <padding>
        <Insets top="24" right="16" bottom="16" left="16"/>
    </padding>

    <Label text="Academic Pulse" styleClass="app-sidebar-brand"/>
    <Label text="FORUM" styleClass="app-sidebar-brand-accent"/>

    <Region prefHeight="24"/>

    <Button fx:id="adminDashboardButton" text="Admin Dashboard" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleAdminDashboard"/>
    <Button fx:id="lecturerDashboardButton" text="Dashboard" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleLecturerDashboard"/>
    <Button fx:id="studentDashboardButton" text="Dashboard" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleStudentDashboard"/>
    <Button text="Discussion Forum" maxWidth="Infinity" styleClass="app-nav-btn, active" onAction="#handleDiscussionForum"/>
    <Button fx:id="topicsButton" text="Topics" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleTopics"/>
    <Button fx:id="complaintsButton" text="Complaints" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleComplaints"/>
    <Button fx:id="membersButton" text="Members" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleMembers"/>
    <Button fx:id="lecturerStudentsButton" text="Students" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleLecturerStudents"/>
    <Button text="Messages" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleMessages"/>
    <Button fx:id="analyticsButton" text="Analytics" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleAnalytics"/>
    <Button fx:id="quizzesButton" text="Quizzes" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleQuizzes"/>
    <Button fx:id="lecturerMarksButton" text="Student Marks" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleLecturerMarks"/>
    <Button fx:id="studentTopicsButton" text="Topics" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleStudentTopics"/>
    <Button fx:id="notificationsButton" text="Notifications" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleNotifications"/>
    <Button text="Settings" maxWidth="Infinity" styleClass="app-nav-btn" onAction="#handleSettings"/>

    <Region VBox.vgrow="ALWAYS"/>

    <Label fx:id="userNameLabel" styleClass="app-sidebar-user-name"/>
    <Label fx:id="userRoleLabel" styleClass="app-sidebar-user-role"/>
    <HBox spacing="6">
        <Button fx:id="lightThemeButton" text="&#9728; Light" styleClass="app-btn-light" onAction="#handleLightTheme" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
        <Button fx:id="darkThemeButton" text="&#9789; Dark" styleClass="app-btn-light" onAction="#handleDarkTheme" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
    </HBox>
    <Button text="Logout" maxWidth="Infinity" styleClass="app-logout-btn" onAction="#handleLogout">
        <VBox.margin>
            <Insets top="10"/>
        </VBox.margin>
    </Button>
</VBox>
