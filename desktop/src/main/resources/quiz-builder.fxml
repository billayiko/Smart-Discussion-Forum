<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.QuizBuilderController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <Button text="&#8592; Back" styleClass="app-btn-light" onAction="#handleBack"/>
            <VBox>
                <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label fx:id="subtitleLabel" style="-fx-text-fill: #71717a;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="14">
                <padding>
                    <Insets top="8" right="16" bottom="16" left="16"/>
                </padding>
                <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>
                <Label fx:id="errorLabel" style="-fx-text-fill: #b91c1c; -fx-font-weight: bold;" wrapText="true"/>

                <VBox styleClass="app-stat-card" spacing="8">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Questions added" style="-fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="progressLabel" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <ProgressBar fx:id="progressBar" maxWidth="Infinity"/>
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label fx:id="progressNoteLabel" style="-fx-text-fill: #71717a;" wrapText="true" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="finalizeButton" text="Save quiz questions" styleClass="app-btn-primary" onAction="#handleFinalize" visible="false" managed="false"/>
                    </HBox>
                </VBox>

                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <javafx.scene.layout.ColumnConstraints percentWidth="55"/>
                        <javafx.scene.layout.ColumnConstraints percentWidth="45"/>
                    </columnConstraints>

                    <VBox styleClass="app-stat-card" spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="0">
                        <Label text="Added questions" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <VBox fx:id="questionsBox" spacing="10"/>
                    </VBox>

                    <VBox fx:id="addQuestionCard" styleClass="app-stat-card" spacing="8" GridPane.rowIndex="0" GridPane.columnIndex="1">
                        <Label text="Add a question" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                        <Label text="Question"/>
                        <TextField fx:id="questionField" promptText="Type the question text"/>
                        <Label text="Option A"/>
                        <TextField fx:id="optionAField"/>
                        <Label text="Option B"/>
                        <TextField fx:id="optionBField"/>
                        <Label text="Option C"/>
                        <TextField fx:id="optionCField"/>
                        <Label text="Option D"/>
                        <TextField fx:id="optionDField"/>
                        <Label text="Correct answer (a, b, c or d)"/>
                        <TextField fx:id="correctOptionField" maxWidth="80"/>
                        <Button text="+ Add question" styleClass="app-btn-primary" onAction="#handleAddQuestion"/>
                    </VBox>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
