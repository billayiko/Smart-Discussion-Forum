<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.ForgotPasswordController" styleClass="app-welcome-root">
    <VBox alignment="CENTER" spacing="12" maxWidth="380">
        <padding>
            <Insets top="60" right="60" bottom="60" left="60"/>
        </padding>
        <Button text="&#8592; Back to Log In" styleClass="app-btn-light" onAction="#handleBack"/>
        <Label text="Forgot your password?" styleClass="app-welcome-title" style="-fx-font-size: 22px;"/>
        <Label text="Verify your identity with your security question to reset it." styleClass="app-welcome-subtitle" wrapText="true"/>
        <TextField fx:id="emailField" promptText="Email"/>
        <ComboBox fx:id="securityQuestionCombo" promptText="Security question" maxWidth="Infinity"/>
        <TextField fx:id="answerField" promptText="Your answer"/>
        <Button fx:id="verifyButton" text="Verify identity" styleClass="app-btn-primary" onAction="#handleVerify" defaultButton="true" maxWidth="Infinity"/>
        <Label fx:id="errorLabel" style="-fx-text-fill: #b91c1c; -fx-font-weight: bold;" wrapText="true"/>
    </VBox>
</StackPane>
