<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.OnboardingController" styleClass="app-welcome-root">
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox alignment="CENTER" spacing="12" maxWidth="420">
            <padding>
                <Insets top="60" right="60" bottom="60" left="60"/>
            </padding>
            <Label text="Welcome! One last step" styleClass="app-welcome-title" style="-fx-font-size: 22px;"/>
            <Label text="Choose your role and set a security question so your account is fully set up." styleClass="app-welcome-subtitle" wrapText="true"/>

            <Label text="I am a..."/>
            <ComboBox fx:id="roleCombo" maxWidth="Infinity"/>

            <Label text="Choose a security question"/>
            <VBox fx:id="securityQuestionBox" spacing="6"/>
            <TextField fx:id="securityAnswerField" promptText="Your answer"/>

            <CheckBox fx:id="agreeCheckbox" text="I agree to the platform rules" wrapText="true"/>

            <HBox spacing="10">
                <Button fx:id="continueButton" text="Continue" styleClass="app-btn-primary" onAction="#handleContinue"/>
                <Button text="Decline &amp; cancel registration" styleClass="app-btn-light" onAction="#handleDecline"/>
            </HBox>
            <Label fx:id="errorLabel" style="-fx-text-fill: #b91c1c; -fx-font-weight: bold;" wrapText="true"/>
        </VBox>
    </ScrollPane>
</StackPane>
