<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.LecturerMarksController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <VBox>
                <Label text="Student Marks" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Forum participation and quiz scores combined into one mark per student." style="-fx-text-fill: #71717a;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </padding>

            <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>
            <Label text="Combined mark = average of participation score and quiz average" style="-fx-text-fill: #71717a; -fx-font-size: 11px;"/>

            <TableView fx:id="marksTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="studentColumn" text="Student" prefWidth="200"/>
                    <TableColumn fx:id="postsColumn" text="Forum Posts" prefWidth="100"/>
                    <TableColumn fx:id="participationColumn" text="Participation" prefWidth="100"/>
                    <TableColumn fx:id="attemptsColumn" text="Quizzes Taken" prefWidth="110"/>
                    <TableColumn fx:id="quizAverageColumn" text="Quiz Average" prefWidth="110"/>
                    <TableColumn fx:id="combinedColumn" text="Combined Mark" prefWidth="120"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
