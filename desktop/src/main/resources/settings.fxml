<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.SettingsController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <VBox>
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <Label text="Settings" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="24">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </padding>

            <VBox spacing="10" styleClass="app-stat-card" maxWidth="420">
                <Label text="Profile" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                <Label text="Name"/>
                <TextField fx:id="nameField"/>
                <Label text="Email"/>
                <TextField fx:id="emailField"/>
                <Button text="Save Profile" styleClass="app-btn-primary" onAction="#handleSaveProfile"/>
                <Label fx:id="profileStatusLabel" wrapText="true" style="-fx-text-fill: #71717a;"/>
            </VBox>

            <VBox spacing="10" styleClass="app-stat-card" maxWidth="420">
                <Label text="Change Password" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>
                <Label text="Current password"/>
                <PasswordField fx:id="currentPasswordField"/>
                <Label text="New password"/>
                <PasswordField fx:id="newPasswordField"/>
                <Label text="Confirm new password"/>
                <PasswordField fx:id="confirmPasswordField"/>
                <Button text="Change Password" styleClass="app-btn-primary" onAction="#handleChangePassword"/>
                <Label fx:id="passwordStatusLabel" wrapText="true" style="-fx-text-fill: #71717a;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
