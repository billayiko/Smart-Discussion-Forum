<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.ConversationDetailController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <Button text="&#8592; Back" styleClass="app-btn-light" onAction="#handleBack"/>
            <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" wrapText="true"/>
            <Label fx:id="groupTagLabel" styleClass="app-tag, app-tag-purple" visible="false" managed="false"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <GridPane hgap="14" vgap="14">
                <padding>
                    <Insets top="8" right="16" bottom="16" left="16"/>
                </padding>
                <columnConstraints>
                    <javafx.scene.layout.ColumnConstraints percentWidth="68"/>
                    <javafx.scene.layout.ColumnConstraints percentWidth="32"/>
                </columnConstraints>

                <VBox spacing="14" GridPane.rowIndex="0" GridPane.columnIndex="0">
                    <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

                    <VBox fx:id="messagesBox" spacing="10"/>

                    <VBox styleClass="app-composer" spacing="8">
                        <Label text="Write a message" style="-fx-font-weight: bold;"/>
                        <HBox spacing="10">
                            <TextArea fx:id="replyField" promptText="Write a message..." prefRowCount="2" wrapText="true" styleClass="app-composer-input" HBox.hgrow="ALWAYS"/>
                            <Button text="Send" styleClass="app-btn-primary" onAction="#handleSend"/>
                        </HBox>
                        <VBox fx:id="exclusionsBox" spacing="4" visible="false" managed="false">
                            <Label text="Exclude specific members from this message (optional)" style="-fx-text-fill: #71717a; -fx-font-size: 11px;"/>
                        </VBox>
                    </VBox>
                </VBox>

                <VBox fx:id="membersPanel" styleClass="app-stat-card" spacing="8" visible="false" managed="false" GridPane.rowIndex="0" GridPane.columnIndex="1">
                    <Label text="Members" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                    <VBox fx:id="membersBox" spacing="6"/>
                    <HBox fx:id="addMemberBox" spacing="6" visible="false" managed="false">
                        <ComboBox fx:id="addMemberCombo" promptText="Add a member..." HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Add" styleClass="app-btn-light" onAction="#handleAddMember"/>
                    </HBox>
                </VBox>
            </GridPane>
        </ScrollPane>
    </center>
</BorderPane>
