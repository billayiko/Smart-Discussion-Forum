<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.ConversationDetailController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <Button text="&#8592; Back" styleClass="app-btn-light" onAction="#handleBack"/>
            <Label fx:id="titleLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" wrapText="true"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="14">
                <padding>
                    <Insets top="8" right="16" bottom="16" left="16"/>
                </padding>
                <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

                <VBox fx:id="messagesBox" spacing="10"/>

                <VBox styleClass="app-composer" spacing="8">
                    <Label text="Write a message" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <TextArea fx:id="replyField" promptText="Write a message..." prefRowCount="2" wrapText="true" styleClass="app-composer-input" HBox.hgrow="ALWAYS"/>
                        <Button text="Send" styleClass="app-btn-primary" onAction="#handleSend"/>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
