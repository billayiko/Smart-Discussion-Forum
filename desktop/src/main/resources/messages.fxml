<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.MessagesController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <VBox>
                <Label text="Messages" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Message classmates, lecturers, or start a group." style="-fx-text-fill: #71717a;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
            <Button text="New Message" styleClass="app-btn-primary" onAction="#handleNewMessage"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="10">
                <padding>
                    <Insets top="8" right="16" bottom="16" left="16"/>
                </padding>
                <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>
                <VBox fx:id="conversationsBox" spacing="10"/>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>
