<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.AdminMembersController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <VBox>
                <Label text="Members" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Manage inactivity warnings and blacklisting for students and lecturers." style="-fx-text-fill: #71717a;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </padding>

            <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

            <VBox spacing="8" styleClass="app-stat-card" maxWidth="Infinity">
                <Label text="Inactivity policy" style="-fx-font-weight: bold;"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Days idle before each warning"/>
                    <TextField fx:id="thresholdField" prefWidth="60"/>
                    <Label text="Days to comply after 2nd warning"/>
                    <TextField fx:id="complianceField" prefWidth="60"/>
                    <Label text="Blacklist duration (days)"/>
                    <TextField fx:id="blacklistDurationField" prefWidth="60"/>
                    <Button text="Save" styleClass="app-btn-primary" onAction="#handleSaveSettings"/>
                </HBox>
            </VBox>

            <TableView fx:id="membersTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="120"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="160"/>
                    <TableColumn fx:id="roleColumn" text="Role" prefWidth="80"/>
                    <TableColumn fx:id="warningsColumn" text="Warnings" prefWidth="70"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
