<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.QuizResultController" style="-fx-background-color: #f7f7fb;">
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
        <VBox alignment="TOP_CENTER" spacing="18">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>

            <VBox styleClass="app-topic-card" spacing="14" maxWidth="720">
                <Label fx:id="titleLabel" style="-fx-font-size: 20px; -fx-font-weight: bold;" wrapText="true"/>
                <Label fx:id="subjectLabel" style="-fx-text-fill: #71717a;"/>
                <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

                <Label fx:id="scoreLabel" style="-fx-font-size: 16px; -fx-font-weight: bold;" visible="false" managed="false"/>
                <Label fx:id="violationsLabel" style="-fx-text-fill: #c46d00; -fx-font-weight: bold;" wrapText="true" visible="false" managed="false"/>
                <Label fx:id="noAttemptLabel" style="-fx-text-fill: #b91c1c; -fx-font-weight: bold;" wrapText="true" visible="false" managed="false"/>

                <Label fx:id="classReportLabel" style="-fx-font-weight: bold;"/>

                <HBox fx:id="confirmBox" spacing="12" alignment="CENTER_LEFT" styleClass="app-stat-card">
                    <Label fx:id="confirmLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="confirmButton" text="Confirm marks" styleClass="app-btn-primary" onAction="#handleConfirmMarks"/>
                </HBox>

                <VBox fx:id="topScorersBox" spacing="6"/>

                <VBox fx:id="reviewBox" spacing="12"/>

                <Button fx:id="backButton" text="🏠 Back to Dashboard" styleClass="app-btn-primary" onAction="#handleBack"/>
            </VBox>
        </VBox>
    </ScrollPane>
</StackPane>
