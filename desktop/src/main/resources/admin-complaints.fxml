<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.AdminComplaintsController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <VBox>
                <Label text="Complaints" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Review reported questions and resolve them." style="-fx-text-fill: #71717a;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </padding>

            <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

            <TableView fx:id="complaintsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="questionColumn" text="Question" prefWidth="200"/>
                    <TableColumn fx:id="authorColumn" text="Author" prefWidth="110"/>
                    <TableColumn fx:id="reasonColumn" text="Reason" prefWidth="220"/>
                    <TableColumn fx:id="reporterColumn" text="Reported by" prefWidth="110"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="180"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
