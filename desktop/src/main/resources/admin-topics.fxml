<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.AdminTopicsController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <VBox>
                <Label text="Topics" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Create topics and assign them to lecturers." style="-fx-text-fill: #71717a;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </padding>

            <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

            <VBox spacing="8" styleClass="app-stat-card" maxWidth="Infinity">
                <Label text="Create a topic" style="-fx-font-weight: bold;"/>
                <HBox spacing="8">
                    <TextField fx:id="titleField" promptText="Topic title" HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="descriptionField" promptText="Description (optional)" HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="newTopicLecturerCombo" promptText="Assign lecturer (optional)"/>
                    <Button text="Create" styleClass="app-btn-primary" onAction="#handleCreate"/>
                </HBox>
            </VBox>

            <TableView fx:id="topicsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="160"/>
                    <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200"/>
                    <TableColumn fx:id="lecturerColumn" text="Lecturer" prefWidth="180"/>
                    <TableColumn fx:id="subscribersColumn" text="Subscribers" prefWidth="90"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="100"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
