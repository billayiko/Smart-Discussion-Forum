<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.academicpulse.desktop.controllers.QuizzesController">
    <left>
        <fx:include source="sidebar.fxml"/>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16"/>
            </padding>
            <VBox>
                <Label text="Quiz Management" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Manage quizzes for your lectures." style="-fx-text-fill: #71717a;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635; Refresh" styleClass="app-btn-light" onAction="#handleRefresh"/>
            <Button text="+ Create quiz" styleClass="app-btn-primary" onAction="#handleCreateQuiz"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="14">
            <padding>
                <Insets top="8" right="16" bottom="16" left="16"/>
            </padding>

            <Label fx:id="statusLabel" style="-fx-text-fill: #71717a;"/>

            <FlowPane fx:id="statsBox" hgap="12" vgap="12"/>

            <TableView fx:id="quizzesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="titleColumn" text="Title" prefWidth="170"/>
                    <TableColumn fx:id="subjectColumn" text="Subject" prefWidth="110"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="90"/>
                    <TableColumn fx:id="questionsColumn" text="Questions" prefWidth="80"/>
                    <TableColumn fx:id="scheduledColumn" text="Scheduled" prefWidth="140"/>
                    <TableColumn fx:id="marksColumn" text="Marks" prefWidth="110"/>
                    <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="200"/>
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
